APP_NAME=HireHub
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

FRONTEND_URL=http://localhost:8000
SANCTUM_STATEFUL_DOMAINS=localhost:8000,localhost:5173,localhost,127.0.0.1,127.0.0.1:8000
# Comma separated list of hostnames the API answers to. Leave empty on
# localhost; set it in every deployed environment (e.g. hirehub.com,www.hirehub.com)
# so a forged Host header cannot rewrite the links sent by email.
APP_TRUSTED_HOSTS=
# Reverse proxy or load balancer addresses, comma separated. X-Forwarded-* is
# only honoured from these, otherwise a client could forge its own IP and slip
# past the rate limiters. Use '*' only when the app port is unreachable directly.
TRUSTED_PROXIES=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# --- Security policy -------------------------------------------------------
# Both must be true before the API will ever return a stack trace. Leave
# SECURITY_EXPOSE_DEBUG unset in production.
SECURITY_EXPOSE_DEBUG=false
SECURITY_PASSWORD_MIN_LENGTH=8
SECURITY_PASSWORD_MAX_LENGTH=72
# Failed logins allowed per (email + IP) before the pair is locked out.
SECURITY_LOCKOUT_ATTEMPTS=5
# Seconds an account stays locked after too many failures.
SECURITY_LOCKOUT_DECAY=900
# Lifetime of an issued API token, in seconds (default 60 days).
SECURITY_TOKEN_TTL=5184000
SECURITY_TOKEN_NAME=auth
# Max CV upload size in kilobytes.
SECURITY_CV_MAX_KB=5120
# Strict-Transport-Security max-age in seconds.
SECURITY_HSTS_MAX_AGE=31536000

# --- Seeded credentials ----------------------------------------------------
# The seeders never hardcode a password. AdminSeeder refuses to create admin
# accounts in production unless ADMIN_SEED_PASSWORD is set; the demo companies
# and job seekers all share SEED_DEMO_PASSWORD.
ADMIN_SEED_PASSWORD=
SEED_DEMO_PASSWORD=

# --- API tokens ------------------------------------------------------------
SANCTUM_TOKEN_EXPIRATION=5184000
# A recognisable prefix means a leaked HireHub token is identifiable by secret
# scanners on GitHub. Changing this invalidates tokens issued before the change.
SANCTUM_TOKEN_PREFIX=hh_

# --- CORS ------------------------------------------------------------------
# Seconds a browser may cache the CORS preflight result.
CORS_MAX_AGE=3600

# --- Sessions --------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Defaults to true everywhere except APP_ENV=local, where XAMPP serves over http.
# SESSION_SECURE_COOKIE=true

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hirehub
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# MAIL_ENABLED=false + MAIL_MAILER=log is the local default: codes are written
# to the `otp-codes` log channel instead of being sent, so the signup and reset
# flows can be walked without a mail account. Set MAIL_ENABLED=true (and
# BREVO_API_KEY below) to deliver for real.
MAIL_ENABLED=false
MAIL_MAILER=log
MAIL_SCHEME=null
# MAIL_ENCRYPTION drives MAIL_SCHEME when that is null: `tls` for port 587,
# `ssl` for port 465.
MAIL_ENCRYPTION=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
# The sender must be an address the chosen provider is allowed to send from.
# Resend rejects a gmail.com sender as an unverified domain; use
# onboarding@resend.dev (account owner's inbox only) locally, or a verified
# domain in production.
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Absolute logo URL in transactional mail. Defaults to
# ${APP_URL}/build/logo.png, which is where Vite copies frontend/public/logo.png.
MAIL_LOGO_URL=
# Resend (https://resend.com) — set MAIL_MAILER=resend and MAIL_ENABLED=true to
# deliver through Resend. Also accepted as RESEND_API_KEY, Laravel's own name.
RESEND_KEY=
# Every one-time password — signup verification and password reset alike —
# uses Brevo's transactional HTTPS API over port 443. Set BREVO_API_KEY to a
# Brevo API key in any environment where codes must actually arrive; without
# it, delivery fails loudly rather than falling back to the mailer.
BREVO_API_KEY=
# Newsletters, platform notices and other application mail still use the
# configured Laravel mailer above (MAIL_MAILER / MAIL_PASSWORD).
# MAIL_FROM_ADDRESS must be a sender verified in the Brevo account.

# Payments — required for subscriptions AND for confirming a hire.
# A hire is only finalized once the gateway signs off via webhook, so a
# gateway left blank here means the "Pay & Confirm Hire" button cannot
# complete. Set at least the keys for PAYMENT_GATEWAY below.
PAYMENT_GATEWAY=paystack
PAYMENT_CURRENCY=NGN
# How long an initialised checkout may sit unpaid before it is abandoned.
PAYMENT_EXPIRY_MINUTES=60
# Per-user throttle on checkout initialisation, to protect gateway quota.
PAYMENT_RATE_LIMIT_INITIALIZE=10
PAYMENT_RATE_LIMIT_INITIALIZE_DECAY=10

# Paystack signs webhooks with HMAC SHA512 over the raw body using the SECRET
# KEY, so these two are the whole integration. There is no separate webhook
# secret to set (that is a Stripe `whsec_` thing).
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_HASH=

STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe webhooks carry a signed timestamp; this is the replay window in seconds.
STRIPE_WEBHOOK_TOLERANCE=300

# Webhooks are POSTed to https://<your-host>/api/v1/webhooks/<gateway>
# (e.g. /api/v1/webhooks/paystack). Each gateway's callback URL must be
# registered in that gateway's dashboard using the same secret set above.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
